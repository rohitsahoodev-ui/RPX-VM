# RPX Panel Configuration
DEBUG=True
PORT=3000
HOST=0.0.0.0

# Security
JWT_SECRET=change_this_to_something_very_secure_rpx_2026
ADMIN_PASSWORD=admin_rpx_panel

# Database
DB_PATH=rpx_panel.db

# Features
ENABLE_BILLING=True
ENABLE_REFERRALS=True
ENABLE_API=True

# LXC Configuration (Mocked in preview, real on Ubuntu/Debian)
LXC_PATH=/var/lib/lxc
DEFAULT_BRIDGE=lxcbr0
DEFAULT_OS=ubuntu-22.04
